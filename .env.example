# Amnezia Web Panel — переменные окружения
# Скопируйте в .env и заполните. В docker-compose значения читаются автоматически.

# Ключ подписи cookie-сессий (обязателен; сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me

# Мастер-ключ шифрования секретов серверов (AES-256-GCM).
# Обязателен при первом старте; если не задан — генерируется и сохраняется в volume.
# НЕ должен совпадать с SECRET_KEY.
# PANEL_MASTER_KEY=

# Путь к файлу БД SQLite (внутри контейнера — в volume amnezia_data)
DB_FILE=data/panel.db

# Порт панели
APP_PORT=8000

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Каталоги (внутри контейнера — в volume)
LOG_DIR=logs
BACKUP_DIR=backups
